{
    "name": "ros2-humble",
    "build": {
      "dockerfile": "Dockerfile",
      "args": { "ROS_DISTRO": "humble" }
    },
    "settings": {
      "terminal.integrated.defaultProfile.linux": "bash"
    },
    "extensions": [
      "ms-iot.vscode-ros",
      "ms-vscode.cpptools",
      "ms-python.python"
    ],
    "postCreateCommand": "sudo apt update && sudo apt install -y python3-colcon-common-extensions",
    "remoteUser": "root"
  }
  